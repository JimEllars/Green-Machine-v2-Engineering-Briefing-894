{
  "name": "axim-green-machine",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cf:worker:types": "wrangler types --env-interface CloudflareEnv edge-ledger-worker/src/worker-configuration.d.ts",
    "cf:worker:deploy": "cd edge-ledger-worker && npx wrangler deploy",
    "cf:pages:deploy": "npx wrangler pages project create green-machine-v2 || true && npx wrangler pages deploy dist --project-name green-machine-v2",
    "test": "vitest run"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.5",
    "@supabase/supabase-js": "^2.45.4",
    "chart.js": "^4.4.4",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.4",
    "jose": "^6.2.12",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@eslint/js": "^9.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.1"
  }
}
